<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/n_merchant" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
      android:textColor="@color/w_ink" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <FrameLayout android:layout_width="wrap_content" android:layout_height="20dp" android:layout_marginStart="12dp">
      <ImageView android:id="@+id/n_amount_light" style="@style/WLightOnly" android:layout_width="wrap_content" android:layout_height="match_parent"
        android:adjustViewBounds="true" android:scaleType="fitEnd" android:contentDescription="Сумма" />
      <ImageView android:id="@+id/n_amount_dark" style="@style/WDarkOnly" android:layout_width="wrap_content" android:layout_height="match_parent"
        android:adjustViewBounds="true" android:scaleType="fitEnd" android:contentDescription="Сумма" />
    </FrameLayout>
  </LinearLayout>
  <TextView android:id="@+id/n_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
    android:textColor="@color/w_muted" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
    <TextView android:id="@+id/n_b0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" 
      android:gravity="center" android:paddingHorizontal="10dp" android:background="@drawable/n_pill_primary" android:textColor="@color/n_primary_ink"
      android:textSize="14sp" android:textStyle="bold" android:maxLines="1"
      android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
    <FrameLayout android:layout_width="8dp" android:layout_height="1dp" />
    <TextView android:id="@+id/n_b1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" 
      android:gravity="center" android:paddingHorizontal="10dp" android:background="@drawable/n_pill" android:textColor="@color/w_ink"
      android:textSize="14sp" android:textStyle="bold" android:maxLines="1"
      android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
    <TextView android:id="@+id/n_b2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" 
      android:gravity="center" android:paddingHorizontal="10dp" android:background="@drawable/n_pill" android:textColor="@color/w_ink"
      android:textSize="14sp" android:textStyle="bold" android:maxLines="1"
      android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
    <FrameLayout android:layout_width="8dp" android:layout_height="1dp" />
    <TextView android:id="@+id/n_more" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:gravity="center"
      android:text="Все категории…" android:textColor="@color/w_muted" android:textSize="14sp" android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
