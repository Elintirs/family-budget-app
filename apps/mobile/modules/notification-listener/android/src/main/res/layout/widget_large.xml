<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:paddingHorizontal="18dp" android:paddingTop="16dp" android:paddingBottom="14dp" android:background="@drawable/w_bg">
  <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/w_caption" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Можно сегодня"
      android:textStyle="bold" android:textColor="@color/w_muted" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/w_pending" android:layout_width="wrap_content" android:layout_height="24dp" android:gravity="center"
      android:paddingHorizontal="10dp" android:background="@drawable/w_pill" android:textStyle="bold"
      android:textColor="@color/w_warn" android:textSize="12sp" android:visibility="gone" />
  </LinearLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:layout_marginBottom="10dp">
    <ImageView android:id="@+id/w_num_light" style="@style/WLightOnly" android:layout_width="match_parent" android:layout_height="match_parent"
      android:scaleType="fitStart" android:contentDescription="Сумма" />
    <ImageView android:id="@+id/w_num_dark" style="@style/WDarkOnly" android:layout_width="match_parent" android:layout_height="match_parent"
      android:scaleType="fitStart" android:contentDescription="Сумма" />
  </FrameLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="8dp">
    <ProgressBar android:id="@+id/w_progress" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent"
      android:layout_height="8dp" android:max="100" android:progressDrawable="@drawable/w_bar" />
    <ProgressBar android:id="@+id/w_progress_over" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent"
      android:layout_height="8dp" android:max="100" android:progressDrawable="@drawable/w_bar_over"  android:visibility="gone" />
  </FrameLayout>
  <TextView android:id="@+id/w_spent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
    android:textStyle="bold" android:textColor="@color/w_muted" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/w_month" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
    android:textColor="@color/w_muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="10dp" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
    <TextView android:id="@+id/w_add" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
      android:gravity="center" android:text="+ Трата" android:textStyle="bold" android:textColor="@color/w_btn_ink" android:textSize="14sp" android:background="@drawable/w_btn" />
    <FrameLayout android:layout_width="8dp" android:layout_height="match_parent" />
    <TextView android:id="@+id/w_inbox" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
      android:gravity="center" android:text="Входящие" android:textStyle="bold" android:textColor="@color/w_ink" android:textSize="14sp" android:background="@drawable/w_btn2" />
  </LinearLayout>
</LinearLayout>
